# Settings for `docker compose up`. Copy to .env and fill in.

# Long random string; encrypts bot tokens and signs sessions. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Don't change it once bots are connected: their saved tokens can't be decrypted otherwise.
ORBIT_SECRET_KEY=

# First operator account, created on the first start only.
ORBIT_ADMIN_EMAIL=admin@example.com
ORBIT_ADMIN_PASSWORD=

# Password for the bundled Postgres database.
POSTGRES_PASSWORD=change-me

# Set to true once Orbit is served over HTTPS.
ORBIT_COOKIE_SECURE=false
