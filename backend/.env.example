# Settings for running the API locally (uv run uvicorn app.main:app). Copy to .env.
# Every setting is optional in development; defaults are shown.

# --- Core ---------------------------------------------------------------------------
# ORBIT_ENVIRONMENT=development           # "production" requires ORBIT_SECRET_KEY
# ORBIT_SECRET_KEY=                       # long random string; encrypts bot tokens
# ORBIT_DATABASE_URL=sqlite+aiosqlite:///./data/orbit.db
# ORBIT_DATABASE_URL=postgresql+asyncpg://orbit:password@localhost:5432/orbit
# ORBIT_MEDIA_DIR=./data/media
# ORBIT_MAX_UPLOAD_MB=50
# ORBIT_STATIC_DIR=                       # path to frontend/dist to serve the console from the API

# --- First operator (created only when no operator exists) ----------------------------
ORBIT_BOOTSTRAP_ADMIN_EMAIL=ops@example.com
ORBIT_BOOTSTRAP_ADMIN_PASSWORD=change-me-please

# --- Sessions -------------------------------------------------------------------------
# ORBIT_SESSION_TTL_HOURS=72
# ORBIT_COOKIE_SECURE=false               # true behind HTTPS

# --- Telegram -------------------------------------------------------------------------
# ORBIT_TELEGRAM_API_BASE=https://api.telegram.org

# --- Delivery engine ------------------------------------------------------------------
# ORBIT_RUN_WORKER_IN_API=true            # false = run `python -m app.worker` separately
# ORBIT_SEND_RATE_PER_BOT=25              # messages per second per bot (Telegram allows ~30)
# ORBIT_DELIVERY_BATCH_SIZE=100
# ORBIT_DELIVERY_CONCURRENCY=25
# ORBIT_DELIVERY_MAX_ATTEMPTS=3
# ORBIT_WORKER_POLL_SECONDS=2
